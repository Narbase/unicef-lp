CREATE TABLE IF NOT EXISTS countries (
 id INTEGER PRIMARY KEY,
 name TEXT NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL
 );

CREATE TABLE IF NOT EXISTS uploaded_files_table (
 id INTEGER PRIMARY KEY,
 file_url TEXT NOT NULL,
 file_name TEXT NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL
 );

CREATE TABLE clients (
	id INTEGER NOT NULL,
	username text NOT NULL,
	password_hash text NOT NULL,
	last_login TEXT,
    created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
	CONSTRAINT clients_pkey PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS grades (
 id INTEGER PRIMARY KEY,
 name TEXT NOT NULL,
 thumbnail_id INTEGER,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_grades_thumbnail_id__id FOREIGN KEY (thumbnail_id) REFERENCES uploaded_files_table(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

 CREATE TABLE IF NOT EXISTS students (
  id INTEGER PRIMARY KEY,
  client_id INTEGER NOT NULL UNIQUE ,
  full_name TEXT NOT NULL,
  id_number TEXT,
  gender TEXT NOT NULL,
  date_of_birth TEXT NOT NULL,
  country_id INTEGER NOT NULL,
  school_name TEXT,
  calling_code TEXT,
  local_phone TEXT,
  profile_picture_id INTEGER,
  grade_id INTEGER NOT NULL,
  is_deleted INTEGER DEFAULT 0 NOT NULL,
  created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
  CONSTRAINT fk_students_client_id__id FOREIGN KEY (client_id) REFERENCES clients(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT fk_students_country_id__id FOREIGN KEY (country_id) REFERENCES countries(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT fk_students_profile_picture_id__id FOREIGN KEY (profile_picture_id) REFERENCES uploaded_files_table(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  CONSTRAINT fk_students_grade_id__id FOREIGN KEY (grade_id) REFERENCES grades(id) ON DELETE RESTRICT ON UPDATE RESTRICT
  );

 CREATE TABLE IF NOT EXISTS subjects (
 id INTEGER PRIMARY KEY,
 grade_id INTEGER NOT NULL,
 name TEXT NOT NULL,
 description TEXT,
 thumbnail_id INTEGER NOT NULL,
 has_certificate INTEGER NOT NULL,
 is_lessons_order_restrictive INTEGER NOT NULL,
 has_feedback_form INTEGER NOT NULL,
 enrollment_type TEXT NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_subjects_grade_id__id FOREIGN KEY (grade_id) REFERENCES grades(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_subjects_thumbnail_id__id FOREIGN KEY (thumbnail_id) REFERENCES uploaded_files_table(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

 CREATE TABLE IF NOT EXISTS lessons (
 id INTEGER PRIMARY KEY,
 subject_id INTEGER NOT NULL,
 title TEXT NOT NULL,
 type TEXT NOT NULL,
 lesson_order INTEGER NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_lessons_subject_id__id FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT ON UPDATE RESTRICT
  );

 CREATE TABLE IF NOT EXISTS student_standard_lessons (
 id INTEGER PRIMARY KEY,
 student_id INTEGER NOT NULL,
 lesson_id INTEGER NOT NULL,
 is_completed INTEGER NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_student_lessons_student_id__id FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_lessons_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES lessons(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

 CREATE TABLE IF NOT EXISTS student_graded_assessments (
 id INTEGER PRIMARY KEY,
 student_id INTEGER NOT NULL,
 lesson_id INTEGER NOT NULL,
 progress REAL NOT NULL,
 answers BLOB NOT NULL,
 attempts INTEGER,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_student_assessments_student_id__id FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_assessments_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES graded_assessments(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

 CREATE TABLE IF NOT EXISTS student_non_graded_assessments (
 id INTEGER PRIMARY KEY,
 student_id INTEGER NOT NULL,
 lesson_id INTEGER NOT NULL,
 progress REAL NOT NULL,
 answers BLOB NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_student_assessments_student_id__id FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_assessments_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES non_graded_assessments(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

 CREATE TABLE IF NOT EXISTS student_subjects (
 id INTEGER PRIMARY KEY,
 student_id INTEGER NOT NULL,
 subject_id INTEGER NOT NULL,
 completed_on TEXT,
 certificate TEXT,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_student_subjects_student_id__id FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_subjects_subject_id__id FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

 CREATE TABLE IF NOT EXISTS student_grades (
 id INTEGER PRIMARY KEY,
 student_id INTEGER NOT NULL,
 grade_id INTEGER NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_student_grades_student_id__id FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_grades_grade_id__id FOREIGN KEY (grade_id) REFERENCES grades(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

CREATE TABLE IF NOT EXISTS standard_lessons (
 id INTEGER PRIMARY KEY,
 lesson_id INTEGER NOT NULL,
 file_id INTEGER NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_standard_lessons_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES lessons(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_standard_lessons_file_id__id FOREIGN KEY (file_id) REFERENCES uploaded_files_table(id) ON DELETE RESTRICT ON UPDATE RESTRICT
);

CREATE TABLE IF NOT EXISTS graded_assessments (
 id INTEGER PRIMARY KEY,
 lesson_id INTEGER NOT NULL,
 form BLOB NOT NULL,
 are_questions_shuffled INTEGER NOT NULL,
 maximum_allowed_attempts INTEGER NOT NULL,
 are_answers_shown INTEGER NOT NULL,
 are_options_shuffled INTEGER NOT NULL,
 passing_percentage REAL NOT NULL,
 is_deleted INTEGER DEFAULT 0 NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_graded_assessments_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES lessons(id) ON DELETE RESTRICT ON UPDATE RESTRICT
);

CREATE TABLE IF NOT EXISTS non_graded_assessments (
  id INTEGER PRIMARY KEY,
  lesson_id INTEGER NOT NULL,
  form BLOB NOT NULL,
  is_deleted INTEGER DEFAULT 0 NOT NULL,
  created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
  CONSTRAINT fk_non_graded_assessments_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES lessons(id) ON DELETE RESTRICT ON UPDATE RESTRICT
);

CREATE TABLE IF NOT EXISTS student_activity_log (
 id INTEGER PRIMARY KEY,
 student_id INTEGER NOT NULL,
 grade_id INTEGER NOT NULL,
 activity_type TEXT NOT NULL,
 lesson_id INTEGER,
 score REAL,
 answers BLOB,
 attempts INTEGER,
 start_time TEXT NOT NULL,
 end_time TEXT NOT NULL,
 created_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL,
 CONSTRAINT fk_student_activity_log_student_id__id FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_activity_log_grade_id__id FOREIGN KEY (grade_id) REFERENCES grades(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
 CONSTRAINT fk_student_activity_log_lesson_id__id FOREIGN KEY (lesson_id) REFERENCES lessons(id) ON DELETE RESTRICT ON UPDATE RESTRICT
 );

CREATE TABLE IF NOT EXISTS dashboard_migration (
 id INTEGER PRIMARY KEY,
 migration TEXT NOT NULL,
 version TEXT NOT NULL UNIQUE,
 installed_on TEXT DEFAULT CURRENT_TIMESTAMP NOT NULL
);